// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Roles
enum UserRole {
  OWNER
  PROVIDER
  ADMIN
}

enum NotificationType {
  MATCH
  MESSAGE
  GROUP_MESSAGE
  COMMENT
  LIKE
  APPOINTMENT
  EVENT_ATTEND
  PROVIDER_REQUEST
  GROUP_JOIN
  LOST_PET_ALERT
  SIGHTING
  ADOPTION_APPLICATION
  ADOPTION_MATCH
  FOSTER_OFFER
  FOSTER_RESPONSE
  FOSTER_PLACEMENT
  FOSTER_CASE_ALERT
  FOSTER_ADOPTION
  VOLUNTEER_OFFER
  VOLUNTEER_RESPONSE
  VOLUNTEER_ASSIGNMENT
  SOLIDARITY_ADOPTION_ALERT
  SOLIDARITY_VETERINARY_ALERT
  CONTENT_REPORT
}

enum ProviderRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FosterProfileStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum RescueCaseStatus {
  SEARCHING
  INTERESTED
  COORDINATING
  ASSISTANCE_ACTIVE
  IN_FOSTER
  RESOLVED
  NEEDS_ADOPTION
  CANCELLED
}

enum RescueNeedType {
  FOSTER
  VETERINARY
  TRANSPORT
  SUPPLIES
  FIELD_SUPPORT
}

enum RescueNeedStatus {
  OPEN
  INTERESTED
  ASSIGNED
  ACTIVE
  FULFILLED
  CANCELLED
}

enum VolunteerProfileStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum VolunteerRole {
  TRANSPORT
  VET_COMPANION
  FIELD_SUPPORT
  SUPPLIES_LOGISTICS
}

enum RescueOfferSource {
  MATCHING
  WALL
}

enum VolunteerOfferStatus {
  PENDING
  INTERESTED
  DECLINED
  SELECTED
  CLOSED
  EXPIRED
}

enum VolunteerAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SolidarityAlertType {
  FOSTER
  ADOPTION
  VETERINARY
}

enum PushDeliveryStatus {
  PENDING
  SENT
  RECEIVED
  CLICKED
  FAILED
}

enum RescueUrgency {
  NORMAL
  HIGH
  CRITICAL
}

enum FosterOfferStatus {
  PENDING
  INTERESTED
  DECLINED
  SELECTED
  CLOSED
  EXPIRED
}

enum FosterPlacementStatus {
  COORDINATING
  ACTIVE
  AWAITING_ADOPTION
  COMPLETED
  CANCELLED
}

enum FosterAdoptionDraftStatus {
  DRAFT
  PUBLISHED
  MATCHED
  COMPLETED
  PAUSED
}

enum PetCareRole {
  OWNED
  FOSTER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  password       String?
  role           UserRole  @default(OWNER)
  isBlocked      Boolean   @default(false)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syntheticRunId String?

  accounts               Account[]
  sessions               Session[]
  owner                  Owner?
  providerProfile        ProviderProfile?
  profile                Profile? // Legacy - for backward compatibility
  sentMessages           Message[]               @relation("SentMessages")
  receivedMessages       Message[]               @relation("ReceivedMessages")
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  appointments           Appointment[] // Citas como cliente
  events                 Event[]
  eventAttendees         EventAttendee[]
  eventDismissals        EventDismissal[]
  invitationsSent        Invitation[]            @relation("InvitationsSent")
  invitationsReceived    Invitation[]            @relation("InvitationsReceived")
  createdGroups          Group[]
  groupMemberships       GroupMember[]
  blockedUsers           BlockedUser[]           @relation("BlockerUser")
  blockedByUsers         BlockedUser[]           @relation("BlockedUser")
  reports                Report[]                @relation("ReporterUser")
  reportedBy             Report[]                @relation("ReportedUser")
  stores                 Store[]
  providerRequests       ProviderRequest[]
  settings               UserSettings?
  notifications          Notification[]          @relation("UserNotifications")
  actedNotifications     Notification[]          @relation("ActorNotifications")
  storeReviews           StoreReview[]
  helpfulReviewVotes     ReviewHelpful[]
  reviewReports          ReviewReport[]
  petSightings           PetSighting[]
  adopterProfile         AdopterProfile?
  adoptionListings       AdoptionListing[]
  adoptionApplications   AdoptionApplication[]
  fosterProfile          FosterProfile?
  rescueCases            RescueCase[]
  rescueCaseEvents       RescueCaseEvent[]       @relation("RescueCaseEventActor")
  fosterAdoptionDrafts   FosterAdoptionDraft[]   @relation("FosterAdoptionManager")
  volunteerProfile       VolunteerProfile?
  solidarityAlertProfile SolidarityAlertProfile?
  pushSubscriptions      PushSubscription[]
  syntheticRun           SyntheticRun?           @relation(fields: [syntheticRunId], references: [id], onDelete: Cascade)

  @@index([syntheticRunId])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                String   @default("system")
  matchingPaused       Boolean  @default(false)
  matchDistance        Int      @default(50)
  matchPetTypes        String   @default("[]")
  matchPetSizes        String   @default("[]")
  notifyMatches        Boolean  @default(true)
  notifyMessages       Boolean  @default(true)
  notifyComments       Boolean  @default(true)
  notifyEvents         Boolean  @default(true)
  notifyHealth         Boolean  @default(true)
  notifyFoster         Boolean  @default(true)
  profileVisible       Boolean  @default(true)
  hideResolvedLostPets Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  entityId  String?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  user           User           @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?          @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  pushDeliveries PushDelivery[]

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model ProviderRequest {
  id           String                @id @default(cuid())
  userId       String
  businessName String
  description  String?
  location     String
  reason       String
  status       ProviderRequestStatus @default(PENDING)
  adminNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ProviderProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  businessName String
  description  String?
  location     String
  rating       Float     @default(0)
  reviewCount  Int       @default(0)
  services     Service[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(cuid())
  providerId  String
  storeId     String?
  name        String
  description String
  price       Float
  duration    Int // en minutos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  store        Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([storeId])
}

model Appointment {
  id        String   @id @default(cuid())
  serviceId String
  userId    String // Cliente (Dueño)
  petId     String
  date      DateTime
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet     Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  review  StoreReview?

  @@index([userId])
  @@index([serviceId])
}

model Post {
  id               String    @id @default(cuid())
  authorId         String
  petId            String? // Opcional: post vinculado a mascota
  postType         String    @default("post") // post, photo, event, question, lost_pet
  content          String
  images           String // JSON array
  location         String?
  eventDate        DateTime? // For event posts
  eventLocation    String? // For event posts
  contactPhone     String? // For lost_pet posts
  lastSeenLocation String? // For lost_pet posts
  isResolved       Boolean   @default(false) // For lost_pet - mascota encontrada
  isVisible        Boolean   @default(true)
  rescueCaseId     String?   @unique
  latitude         Float?
  longitude        Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pet         Pet?          @relation(fields: [petId], references: [id], onDelete: SetNull)
  comments    Comment[]
  likes       Like[]
  invitations Invitation[]
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventId     String? // Link to actual Event entity
  event       Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sightings   PetSighting[]
  rescueCase  RescueCase?   @relation(fields: [rescueCaseId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([createdAt])
  @@index([postType, isResolved, createdAt])
  @@index([isVisible, createdAt])
}

model Invitation {
  id        String   @id @default(cuid())
  postId    String // Post with type=event
  inviterId String // Who sent
  inviteeId String // Who receives
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())

  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  bio       String
  age       Int
  gender    String
  interests String
  location  String
  images    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Owner {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  phone        String?
  location     String
  bio          String?
  image        String? // Profile photo URL
  hasYard      Boolean?
  hasOtherPets Boolean?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pets Pet[]
}

model PetHealthRecord {
  id          String    @id @default(cuid())
  petId       String
  type        String // VACCINE, CHECKUP, MEDICATION
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model Pet {
  id                String      @id @default(cuid())
  ownerId           String
  name              String
  petType           String
  breed             String?
  age               Int
  weight            Float? // Nuevo campo
  size              String
  gender            String
  vaccinated        Boolean?
  neutered          Boolean?
  energy            String
  bio               String
  activities        String
  location          String
  images            String
  thumbnailIndex    Int         @default(0)
  latitude          Float?
  longitude         Float?
  publicSlug        String?     @unique
  emergencyToken    String?     @unique
  sharePhoneOnScan  Boolean     @default(true)
  shareVetOnScan    Boolean     @default(false)
  goodWithKids      String?
  goodWithDogs      String?
  goodWithCats      String?
  goodWithStrangers String?
  temperament       String?
  microchipId       String?
  allergies         String?
  specialNeeds      String?
  vetClinicName     String?
  matchIntent       String      @default("[]")
  careRole          PetCareRole @default(OWNED)

  // Gamification basic
  level        Int @default(1)
  xp           Int @default(0)
  totalMatches Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                Owner                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sentSwipes           Swipe[]               @relation("PetSentSwipes")
  receivedSwipes       Swipe[]               @relation("PetReceivedSwipes")
  match1               Match[]               @relation("Pet1Matches")
  match2               Match[]               @relation("Pet2Matches")
  posts                Post[]
  appointments         Appointment[]
  healthRecords        PetHealthRecord[]
  adoptionListings     AdoptionListing[]
  rescueCases          RescueCase[]
  fosterAdoptionDrafts FosterAdoptionDraft[]

  @@unique([ownerId, name], name: "ownerId_name")
  @@index([ownerId])
  @@index([latitude, longitude])
}

model Swipe {
  id        String   @id @default(cuid())
  fromId    String   @default("") // Legacy — kept for data compat
  toId      String   @default("") // Legacy — kept for data compat
  fromPetId String?
  toPetId   String?
  isLike    Boolean
  createdAt DateTime @default(now())

  fromPet Pet? @relation("PetSentSwipes", fields: [fromPetId], references: [id], onDelete: Cascade)
  toPet   Pet? @relation("PetReceivedSwipes", fields: [toPetId], references: [id], onDelete: Cascade)

  @@unique([fromPetId, toPetId])
  @@index([fromPetId])
  @@index([toPetId])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String   @default("") // Legacy — kept for data compat
  user2Id   String   @default("") // Legacy — kept for data compat
  pet1Id    String?
  pet2Id    String?
  createdAt DateTime @default(now())

  pet1     Pet?      @relation("Pet1Matches", fields: [pet1Id], references: [id], onDelete: Cascade)
  pet2     Pet?      @relation("Pet2Matches", fields: [pet2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([pet1Id])
  @@index([pet2Id])
}

model Event {
  id           String   @id @default(cuid())
  authorId     String
  title        String
  description  String?
  date         DateTime
  location     String
  image        String?
  maxAttendees Int?
  category     String   @default("otro")
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attendees  EventAttendee[]
  dismissals EventDismissal[]
  groupId    String?
  group      Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  posts      Post[]
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventDismissal {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Message {
  id                    String   @id @default(cuid())
  matchId               String?
  groupId               String?
  adoptionApplicationId String?
  fosterOfferId         String?
  volunteerOfferId      String?
  fosterPlacementId     String?
  volunteerAssignmentId String?
  senderId              String
  receiverId            String?
  content               String
  read                  Boolean  @default(false)
  createdAt             DateTime @default(now())

  match               Match?               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  adoptionApplication AdoptionApplication? @relation(fields: [adoptionApplicationId], references: [id], onDelete: Cascade)
  fosterOffer         FosterOffer?         @relation(fields: [fosterOfferId], references: [id], onDelete: Cascade)
  volunteerOffer      VolunteerOffer?      @relation(fields: [volunteerOfferId], references: [id], onDelete: Cascade)
  fosterPlacement     FosterPlacement?     @relation(fields: [fosterPlacementId], references: [id], onDelete: Cascade)
  volunteerAssignment VolunteerAssignment? @relation(fields: [volunteerAssignmentId], references: [id], onDelete: Cascade)
  sender              User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver            User?                @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([groupId])
  @@index([adoptionApplicationId])
  @@index([fosterOfferId])
  @@index([volunteerOfferId])
  @@index([fosterPlacementId])
  @@index([volunteerAssignmentId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String
  image       String?
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  posts    Post[]
  events   Event[]
  messages Message[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER") // MEMBER, ADMIN
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model StoreCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores Store[]
}

model Store {
  id            String    @id @default(cuid())
  categoryId    String
  providerId    String? // null until admin assigns to a provider
  name          String
  slug          String    @unique
  description   String?
  phone         String?
  email         String?
  address       String?
  image         String?
  images        String    @default("[]") // JSON array
  isActive      Boolean   @default(true)
  ratingAverage Float     @default(0)
  reviewCount   Int       @default(0)
  latitude      Float?
  longitude     Float?
  tags          String    @default("[]")
  plan          String    @default("FREE")
  featuredUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category        StoreCategory    @relation(fields: [categoryId], references: [id])
  provider        User?            @relation(fields: [providerId], references: [id])
  services        StoreService[]
  bookingServices Service[]
  reviews         StoreReview[]
  promotions      StorePromotion[]

  @@index([categoryId])
  @@index([providerId])
  @@index([latitude, longitude])
}

model StoreReview {
  id              String    @id @default(cuid())
  storeId         String
  authorId        String
  appointmentId   String?   @unique
  rating          Int
  comment         String?
  status          String    @default("PUBLISHED") // PUBLISHED, HIDDEN
  businessReply   String?
  businessReplyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  helpfulVotes ReviewHelpful[]
  reports      ReviewReport[]

  @@unique([storeId, authorId])
  @@index([storeId, status, createdAt])
  @@index([authorId])
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review StoreReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewReport {
  id          String   @id @default(cuid())
  reviewId    String
  reporterId  String
  reason      String
  description String?
  status      String   @default("PENDING") // PENDING, REVIEWED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  review   StoreReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@index([reporterId])
}

model StoreService {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String
  price       Float
  duration    Int // minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  targetType  String   @default("USER") // USER, POST, COMMENT, ALERT
  targetId    String?
  reason      String // spam, inappropriate, harassment, other
  description String?
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
  @@index([targetType, targetId])
}

model PetSighting {
  id         String   @id @default(cuid())
  postId     String
  reporterId String
  notes      String?
  location   String?
  latitude   Float?
  longitude  Float?
  image      String?
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([reporterId])
}

model AdopterProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  housingType    String
  hasYard        Boolean  @default(false)
  hasKids        Boolean  @default(false)
  hasOtherPets   Boolean  @default(false)
  experience     String
  hoursAvailable String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdoptionListing {
  id                 String   @id @default(cuid())
  petId              String
  listedByUserId     String
  sourceRescueCaseId String?  @unique
  status             String   @default("OPEN")
  character          String?
  specialNeeds       String?
  requirements       String?
  location           String?
  latitude           Float?
  longitude          Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pet              Pet                   @relation(fields: [petId], references: [id], onDelete: Cascade)
  listedBy         User                  @relation(fields: [listedByUserId], references: [id], onDelete: Cascade)
  applications     AdoptionApplication[]
  sourceRescueCase RescueCase?           @relation("RescueCaseAdoptionListing", fields: [sourceRescueCaseId], references: [id], onDelete: SetNull)
  fosterDraft      FosterAdoptionDraft?  @relation("FosterAdoptionListing")

  @@index([petId])
  @@index([listedByUserId])
  @@index([status, createdAt])
}

model AdoptionApplication {
  id                 String   @id @default(cuid())
  listingId          String
  applicantId        String
  status             String   @default("PENDING")
  message            String?
  compatibilityScore Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listing          AdoptionListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicant        User                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  messages         Message[]
  selectedForDraft FosterAdoptionDraft? @relation("SelectedAdoptionApplication")

  @@unique([listingId, applicantId])
  @@index([applicantId])
  @@index([status])
}

model FosterProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  status            FosterProfileStatus @default(ACTIVE)
  acceptsSpecies    String              @default("[]")
  acceptsSizes      String              @default("[]")
  capacity          Int                 @default(1)
  occupiedSlots     Int                 @default(0)
  location          String
  latitude          Float
  longitude         Float
  radiusKm          Int                 @default(5)
  availableFrom     DateTime?
  availableUntil    DateTime?
  maxDurationDays   Int                 @default(30)
  housingType       String
  hasYard           Boolean             @default(false)
  hasKids           Boolean             @default(false)
  hasOtherPets      Boolean             @default(false)
  experience        String
  notes             String?
  adultDeclaredAt   DateTime
  termsAcceptedAt   DateTime
  termsVersion      String
  caseAlertsEnabled Boolean             @default(false)
  alertRadiusKm     Int                 @default(5)
  alertSpecies      String              @default("[]")
  alertUrgencies    String              @default("[]")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers     FosterOffer[]
  placements FosterPlacement[]

  @@index([status])
  @@index([latitude, longitude])
}

model RescueCase {
  id                String           @id @default(cuid())
  createdByUserId   String
  petId             String?
  status            RescueCaseStatus @default(SEARCHING)
  species           String
  size              String
  urgency           RescueUrgency    @default(NORMAL)
  apparentCondition String
  description       String
  images            String
  location          String
  latitude          Float
  longitude         Float
  searchRadiusKm    Int              @default(5)
  requestedDays     Int              @default(14)
  consentAcceptedAt DateTime
  consentVersion    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  createdBy       User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  pet             Pet?                 @relation(fields: [petId], references: [id], onDelete: SetNull)
  offers          FosterOffer[]
  placements      FosterPlacement[]
  events          RescueCaseEvent[]
  communityPost   Post?
  adoptionDraft   FosterAdoptionDraft?
  adoptionListing AdoptionListing?     @relation("RescueCaseAdoptionListing")
  needs           RescueNeed[]

  @@index([createdByUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([latitude, longitude])
}

model RescueNeed {
  id           String           @id @default(cuid())
  rescueCaseId String
  type         RescueNeedType
  isPrimary    Boolean          @default(false)
  details      String?
  status       RescueNeedStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  rescueCase           RescueCase            @relation(fields: [rescueCaseId], references: [id], onDelete: Cascade)
  volunteerOffers      VolunteerOffer[]
  volunteerAssignments VolunteerAssignment[]

  @@unique([rescueCaseId, type])
  @@index([type, status, createdAt])
  @@index([rescueCaseId, isPrimary])
}

model FosterOffer {
  id              String            @id @default(cuid())
  rescueCaseId    String
  fosterProfileId String
  status          FosterOfferStatus @default(PENDING)
  source          RescueOfferSource @default(MATCHING)
  distanceKm      Float
  score           Int
  reasons         String            @default("[]")
  expiresAt       DateTime
  respondedAt     DateTime?
  selectedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rescueCase    RescueCase       @relation(fields: [rescueCaseId], references: [id], onDelete: Cascade)
  fosterProfile FosterProfile    @relation(fields: [fosterProfileId], references: [id], onDelete: Cascade)
  placement     FosterPlacement?
  messages      Message[]

  @@unique([rescueCaseId, fosterProfileId])
  @@index([fosterProfileId, status, createdAt])
  @@index([rescueCaseId, status])
  @@index([expiresAt])
}

model FosterPlacement {
  id                   String                @id @default(cuid())
  rescueCaseId         String
  fosterProfileId      String
  offerId              String                @unique
  status               FosterPlacementStatus @default(COORDINATING)
  requesterConfirmedAt DateTime?
  fosterConfirmedAt    DateTime?
  startedAt            DateTime?
  expectedEndAt        DateTime?
  endedAt              DateTime?
  outcome              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  rescueCase    RescueCase           @relation(fields: [rescueCaseId], references: [id], onDelete: Cascade)
  fosterProfile FosterProfile        @relation(fields: [fosterProfileId], references: [id], onDelete: Cascade)
  offer         FosterOffer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  messages      Message[]
  adoptionDraft FosterAdoptionDraft?

  @@index([rescueCaseId, status])
  @@index([fosterProfileId, status])
}

model RescueCaseEvent {
  id         String            @id @default(cuid())
  caseId     String
  actorId    String
  type       String
  fromStatus RescueCaseStatus?
  toStatus   RescueCaseStatus?
  details    String?
  eventKey   String?           @unique
  payload    Json?
  createdAt  DateTime          @default(now())

  rescueCase RescueCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor      User       @relation("RescueCaseEventActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([actorId])
}

model FosterAdoptionDraft {
  id                    String                    @id @default(cuid())
  rescueCaseId          String                    @unique
  placementId           String                    @unique
  managedByUserId       String
  petId                 String?
  listingId             String?                   @unique
  selectedApplicationId String?                   @unique
  status                FosterAdoptionDraftStatus @default(DRAFT)
  name                  String?
  breed                 String?
  estimatedAge          Int?
  gender                String?
  energy                String?
  character             String?
  bio                   String?
  goodWithKids          String?
  goodWithDogs          String?
  goodWithCats          String?
  vaccinated            Boolean?
  neutered              Boolean?
  specialNeeds          String?
  requirements          String?
  publicZone            String?
  images                String                    @default("[]")
  fosterConfirmedAt     DateTime?
  adopterConfirmedAt    DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  rescueCase          RescueCase           @relation(fields: [rescueCaseId], references: [id], onDelete: Cascade)
  placement           FosterPlacement      @relation(fields: [placementId], references: [id], onDelete: Cascade)
  managedBy           User                 @relation("FosterAdoptionManager", fields: [managedByUserId], references: [id], onDelete: Cascade)
  pet                 Pet?                 @relation(fields: [petId], references: [id], onDelete: SetNull)
  listing             AdoptionListing?     @relation("FosterAdoptionListing", fields: [listingId], references: [id], onDelete: SetNull)
  selectedApplication AdoptionApplication? @relation("SelectedAdoptionApplication", fields: [selectedApplicationId], references: [id], onDelete: SetNull)

  @@index([managedByUserId, status, updatedAt])
}

model VolunteerProfile {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  status             VolunteerProfileStatus @default(ACTIVE)
  roles              String                 @default("[]")
  location           String
  latitude           Float
  longitude          Float
  radiusKm           Int                    @default(5)
  availableFrom      DateTime?
  availableUntil     DateTime?
  maxConcurrentTasks Int                    @default(1)
  occupiedTasks      Int                    @default(0)
  notes              String?
  adultDeclaredAt    DateTime
  termsAcceptedAt    DateTime
  termsVersion       String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers      VolunteerOffer[]
  assignments VolunteerAssignment[]

  @@index([status])
  @@index([latitude, longitude])
}

model VolunteerOffer {
  id                 String               @id @default(cuid())
  needId             String
  volunteerProfileId String
  role               VolunteerRole
  status             VolunteerOfferStatus @default(PENDING)
  source             RescueOfferSource    @default(MATCHING)
  distanceKm         Float
  score              Int
  reasons            String               @default("[]")
  expiresAt          DateTime
  respondedAt        DateTime?
  selectedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  need             RescueNeed           @relation(fields: [needId], references: [id], onDelete: Cascade)
  volunteerProfile VolunteerProfile     @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  assignment       VolunteerAssignment?
  messages         Message[]

  @@unique([needId, volunteerProfileId])
  @@index([volunteerProfileId, status, createdAt])
  @@index([needId, status])
  @@index([expiresAt])
}

model VolunteerAssignment {
  id                 String                    @id @default(cuid())
  needId             String
  volunteerProfileId String
  offerId            String                    @unique
  status             VolunteerAssignmentStatus @default(ACTIVE)
  startedAt          DateTime                  @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  need             RescueNeed       @relation(fields: [needId], references: [id], onDelete: Cascade)
  volunteerProfile VolunteerProfile @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)
  offer            VolunteerOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@index([needId, status])
  @@index([volunteerProfileId, status])
}

model SolidarityAlertProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  location          String
  latitude          Float
  longitude         Float
  locationConsentAt DateTime
  consentVersion    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions SolidaritySubscription[]

  @@index([latitude, longitude])
}

model SolidaritySubscription {
  id        String              @id @default(cuid())
  profileId String
  type      SolidarityAlertType
  enabled   Boolean             @default(false)
  radiusKm  Int                 @default(5)
  species   String              @default("[]")
  sizes     String              @default("[]")
  urgencies String              @default("[]")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  profile SolidarityAlertProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@index([type, enabled])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  disabledAt    DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, disabledAt])
}

model PushDelivery {
  id             String             @id @default(cuid())
  notificationId String
  subscriptionId String
  status         PushDeliveryStatus @default(PENDING)
  payload        Json
  attempts       Int                @default(0)
  providerStatus Int?
  lastError      String?
  sentAt         DateTime?
  receivedAt     DateTime?
  clickedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  notification Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, subscriptionId])
  @@index([status, attempts, updatedAt])
}

model RateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model SyntheticRun {
  id          String    @id @default(cuid())
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users User[]

  @@index([status, expiresAt])
}

model StorePromotion {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  body      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startsAt, endsAt])
}
