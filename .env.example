# Database and authentication values are managed outside Git.
DATABASE_URL=
PRODUCT_SAVED_SEARCHES_ENABLED=false
PRODUCT_BOOKINGS_ENABLED=false
PRODUCT_MEETUPS_ENABLED=false
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Native Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@mascotin.app

# Optional Vercel Blob store for uploaded images. Without it, images are stored inline (base64) in the database.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/maintenance
CRON_SECRET=

# Local/preview visual QA only. Do not put production secrets here.
# QA_STORE_SLUG=
# QA_EMAIL=
# QA_PASSWORD=
